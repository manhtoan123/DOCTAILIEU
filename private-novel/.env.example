# Default TikTok TTS uses the public gateway in src/features/tts/services/tts.ts.
# The default route needs no session. CapCut v2 requires a server-only session secret.
# Changing its origin also requires an explicit server/auth.ts CSP review.

# Optional, nonsecret build selector. Enable only after CapCut session + live MP3 probe pass.
# VITE_TTS_GATEWAY=capcut-v2
# CAPCUT_SESSION_JSON belongs in Pages secrets, never this file/VITE/Git/client storage.
