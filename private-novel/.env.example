# CapCut is the default gateway; its session belongs only in Pages secrets.
# Optional nonsecret build selector for the legacy TikTok gateway:
# VITE_TTS_GATEWAY=legacy-tiktok
# CAPCUT_SESSION_JSON must never be placed in this file, VITE, Git, or client storage.
# Optional nonsecret Convert HTTPS origin. Set CONVERT_SERVER_ORIGIN to the
# same exact origin in the Pages environment to enable it in connect-src.
# VITE_CONVERT_SERVER_ORIGIN=https://convert.example.net
